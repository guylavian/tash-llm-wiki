# Derived, regenerable Phase-3 artifacts — never source of truth, never committed.
# Rebuild from the immutable reference tier with: embed.py --domain <d> --build
/embeddings/
# Temporal knowledge-graph store — derived from the vault; rebuild with: python3 -m wikikb tkg ingest
/tkg/
# Vendored embedding model(s) — large binaries transferred per the offline step in
# models/README.md. Keep the README; ignore the model directories themselves.
models/*
!models/README.md

# Optional ONLINE tier (LiteLLM/LangGraph) — config, caches, vendored wheels, and the regenerable
# usage ledger are never committed; keep the READMEs (cost/ + llm/ hold only docs today).
llm.config.yaml
wheels/
.llm_cache/
.checkpoints/
eval/cost_report.json
cost/*
!cost/README.md
llm/*
!llm/README.md
.venv-embed/
.venv-online/

# NOTE: the scraper keeps no state under _meta/. Its ledger (which crawl has been harvested for
# which source) and its collinfo cache live in the VAULT at `vault/.scrape-state.json`, because
# they are the harvest's memory and must travel with a vault copy.

# Server runtime logs from a detached bare-metal run (`python3 -m wikikb serve` with its
# stdout/stderr redirected here). Progress output, not provenance — the durable record of what
# was ingested is the vault plus .manifest.json.
serve.out
serve.err

# Python packaging artifacts (pip builds run here, next to pyproject.toml)
/build/
/dist/
