# OS / editor cruft
.DS_Store

# Python bytecode
__pycache__/
*.pyc

# Python build / install / cache artifacts (optional `pip install -e .`)
*.egg-info/
.pytest_cache/
/build/
dist/

# Obsidian per-machine session state (app.json/core-plugins/graph are kept)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian.bak/

# Claude Code: track the SHARED config (commands/, agents/, settings.json) so a fresh clone
# reproduces the documented setup — ignore only the per-machine session state.
.claude/settings.local.json

# Redundant local backups — the corpus is canonical in wiki/reference/ (tracked here)
.corpora.bak/
corpora/
*.zip
graphify-out/

# Graphify auto-sync hook output (_meta/hooks/post-commit)
_meta/sync.log

# Raw vendor PDFs — upstream harvest INPUT only (one is 128MB, over GitHub's 100MB
# hard limit). The derived, citable notes in reference/<domain>/ are tracked.
_sources/**/pdfs/

# Local virtualenvs + per-run harvest logs
_meta/.venv-*
deep-research-*.log

# Obsidian per-machine session state (app.json/core-plugins/graph are kept)

# Local runtime config (secrets, host paths) — the committed template is .env.example
.env
.env.local

# Rebuildable vault-adjacent state (dense index); see .env HOST_STATE_DIR
.wiki-state/
