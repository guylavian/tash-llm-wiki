# ─────────────────────────────────────────────────────────────────────────────
#  llm-wiki — runtime configuration
#
#  Copy to `.env` and edit:      cp .env.example .env
#  `.env` is gitignored; THIS file is committed and must never hold a real secret.
#
#  Read by docker-compose automatically. For a bare-metal run, export it first:
#      set -a; . ./.env; set +a; python3 -m wikikb serve
#  (every value below is also a plain CLI flag — the flag wins over the env var)
# ─────────────────────────────────────────────────────────────────────────────

# ── 0. OPERATION MODE ────────────────────────────────────────────────────────
# THE application-level switch. Two modes, and they are ADDITIVE — `online` is a
# strict superset of `airgapped`, so a client written against one works verbatim
# against the other.
#
#   airgapped   (DEFAULT) Serves the vault + MCP, and the PDF write surface:
#               PUT /upload → the file is stored AND the conversion chain is
#               queued (pdf → corpus → immutable reference notes → crosslinked
#               Markdown). Opens no outbound connection, ever.
#   online      Everything above, PLUS the web-scraper surface (/scrape,
#               /scrape/sources, /scrape/cron) and the scheduled harvest that
#               drives it. See section 6.
#
# In airgapped mode the scrape paths answer exactly like an unknown path and are
# absent from /openapi.json, so a sealed instance does not advertise a surface it
# refuses to serve. GET /health reports the live mode and its capabilities.
#
# A TYPO REFUSES TO START (exit 2) rather than falling back to a default — a mode
# is a security posture, and silently getting the wrong one is the failure that
# check exists to prevent. `offline` is accepted as an alias for `airgapped`.
WIKIKB_MODE=airgapped


# ── 1. WHERE THE CONTENT LIVES ───────────────────────────────────────────────
# The HOST directory bind-mounted into the container. Everything the knowledge
# base needs lives under one parent, so migrating between machines is a copy of
# this single directory — page tiers, the immutable reference/_sources tiers,
# the generated indexes, taxonomy.md and .manifest.json all travel together.
#
# Seed it once from the repo:      cp -a ./vault/. /srv/llm-wiki/vault/
# Move it to another host:         copy that directory. That is the whole migration.
#
# Windows: use a forward-slash path, e.g. C:/Users/you/llm-wiki/vault
HOST_VAULT_DIR=./vault

# Host dir for state that is ABOUT the vault but rebuildable — the dense embedding
# index. Kept separate so it never bloats a vault copy; if you lose it, rebuild
# with `python3 -m wikikb embed`. Safe to delete.
HOST_STATE_DIR=./.wiki-state

# Where the vault is mounted INSIDE the container. Must match the compose mount.
# `paths.py` honours this; leaving it unset makes the code fall back to <repo>/vault,
# which is NOT what you want in a container.
WIKIKB_VAULT_ROOT=/data/vault

# The vault SKELETON is created on startup if this path is empty or incomplete — dirs,
# a seeded taxonomy.md, .manifest.json (wikikb/bootstrap.py). It never overwrites an
# existing file and never invents content: an empty mount becomes a valid, WRITABLE
# but EMPTY wiki, not a copy of the repo's. Seed HOST_VAULT_DIR above if you want the
# shipped content. Anything created is logged on stderr, so a typo'd mount path shows
# up in the first lines of `docker logs` instead of as mysteriously empty results.
# Set to 0 to turn the automatic creation off (a missing vault then stays missing):
# WIKIKB_BOOTSTRAP=0

# Staging for an in-flight PDF/docs harvest (pdf_to_corpus -> corpus_to_vault).
# Points inside the mounted volume so a half-finished import survives a restart.
WIKIKB_CORPORA_DIR=/data/corpora


# ── 2. HTTP SURFACE ──────────────────────────────────────────────────────────
# Port INSIDE the container. Change HOST_PORT (below) to move the published port
# without touching this.
WIKIKB_PORT=8642

# Host-side published port — what you actually browse to. Only compose reads this.
HOST_PORT=8642

# Bind address. 0.0.0.0 is correct INSIDE a container (loopback there is reachable
# only from inside it); `docker run -p` is what controls real exposure. Bare-metal
# default is 127.0.0.1 — do not widen it without setting WIKIKB_API_TOKEN.
WIKIKB_BIND=0.0.0.0

# Mount point for MCP-over-HTTP. Default /mcp; change only if it collides with a
# reverse-proxy route. A leading slash is optional (`api/mcp` is normalized to
# `/api/mcp`). Relocating it does not widen the surface — the old path then answers
# exactly like any unknown path.
WIKIKB_MCP_PATH=/mcp


# ── 3. AUTH ──────────────────────────────────────────────────────────────────
# UNSET  = no auth (fine for loopback-only).
# SET    = `Authorization: Bearer <token>` required on every endpoint except
#          /health (left open because kubelet-style probes cannot send headers).
#          /openapi.json and /docs ARE gated — an API map is not probe traffic.
# REQUIRED whenever the service is reachable from a real interface.
#   generate:  openssl rand -hex 32
# WIKIKB_API_TOKEN=

# Comma-separated Origins allowed to POST to the MCP endpoint. Only enforced when
# a browser actually sends an Origin header — the DNS-rebinding guard. Backend
# callers (n8n, agents) send none and are unaffected.
# WIKIKB_MCP_ALLOWED_ORIGINS=https://your-ui.example.com


# ── 4. INGEST (WRITE SURFACE — OFF BY DEFAULT) ───────────────────────────────
# 1/true/yes/on enables the write surface in BOTH modes:
#     PUT  /upload/<domain>/<file>.pdf   store a PDF (raw body, not multipart)
#     POST /ingest/<domain>              queue the conversion chain by hand
# Writes land ONLY in vault/_sources/<domain>/_raw/pdfs/, never the immutable
# reference tier. Disabled, both paths are indistinguishable from an unknown path.
# Leave unset unless you actually want a network-writable surface.
# WIKIKB_ALLOW_UPLOAD=1

# An upload TRIGGERS the conversion by default: pdf_to_corpus --append →
# corpus_to_vault → build (whose crosslink step is what links the new document to
# the other Markdown files). It runs as a BACKGROUND JOB on a single serialized
# worker — `build` regenerates whole-vault artifacts, so two at once would
# interleave writes — and the PUT returns a job_id to poll at GET /jobs/<id>.
#
# Set to 0 for store-only uploads, then batch several drops into one build with
# POST /ingest/<domain>. Note the chain lands the document as an immutable
# REFERENCE NOTE; synthesis pages are still authored against it (INGEST, CLAUDE.md).
# WIKIKB_AUTO_INGEST=0

# Per-step ceiling for a job, in seconds (default 1800). A full `build` on a large
# vault is minutes; this only exists so a wedged step cannot park the single worker
# forever and silently stall every job behind it.
# WIKIKB_JOB_TIMEOUT=1800


# ── 5. WEB SCRAPER (ONLINE MODE ONLY) ────────────────────────────────────────
# Requires BOTH WIKIKB_MODE=online (section 0) AND WIKIKB_ALLOW_UPLOAD=1
# (section 4). The second is not a formality: a scrape writes into the vault, so
# it belongs to the SAME write surface as /upload and /ingest, and an instance
# whose operator deliberately disabled uploads must not be scrape-writable
# through a side door. With uploads off, the read endpoints (GET /scrape/sources,
# GET /scrape/cron) still answer; the writing ones are a hidden 404.
#
# HOW A HARVEST WORKS: each configured source is looked up in EVERY Common Crawl
# index it has not been harvested against yet, newest first (see THE HARVEST
# LEDGER below for why the history and not just the newest). For each crawl that
# has the page, the archived WARC record is range-fetched from
# data.commoncrawl.org, extracted to Markdown, and written to
# vault/_sources/<domain>/_raw/web/ — then the same chain a PDF upload runs folds
# it into the immutable reference tier and relinks the graph:
#     scrape → web_to_corpus → corpus_to_vault → build
# An older capture never overwrites a newer note. If a crawl does not have the
# page the run says so and fetches nothing (unless that source opted into a live
# fetch — see "direct" below).

# The watchlist file. LEAVE THIS COMMENTED unless you really want the watchlist
# somewhere other than the vault: unset, it follows WIKIKB_VAULT_ROOT, which is
# what makes it travel with a vault copy. Setting it DECOUPLES the two — and a
# container path here in a BARE-METAL run resolves against the drive root
# (/data/vault/... -> C:\data\vault\... on Windows), so GET /scrape/sources
# reports a file that does not exist while the startup banner still prints the
# real vault. Same bare-metal vs container split as WIKIKB_VAULT_ROOT above.
#
# Vault-resident so it travels with a vault copy; managed by hand in Obsidian or
# over the API (GET/POST/PATCH/DELETE /scrape/sources).
#   {"version":1,"sources":[
#     {"url":"https://www.keycloak.org/docs/latest/server_admin/",
#      "domain":"keycloak",            # MUST be declared in vault/taxonomy.md
#      "label":"KC admin guide (upstream)",
#      "match":"exact",                # or "prefix": every indexed page under it
#      "enabled":true,
#      "direct":false}]}               # true = allow a LIVE origin fetch when
#                                      # Common Crawl has no capture (guarded:
#                                      # any host resolving to a private/loopback
#                                      # address is refused)
# WIKIKB_SCRAPE_SOURCES=/data/vault/scrape-sources.json

# THE CRON. Default ON, daily at 03:00 local. Accepts a 5-field cron expression,
# an @macro (@hourly/@daily/@weekly/@monthly), or an interval (30m, 6h, 1d — note
# that `6h` means every 6 hours from start, while `0 */6 * * *` means fixed clock
# hours). A MALFORMED value disables the timer and is reported by GET /scrape/cron
# and in the startup log — it does NOT stop the server, unlike a bad WIKIKB_MODE:
# a harvest that does not run is visible and harmless, a wrong posture is not.
# QUOTE IT. A cron expression contains spaces and `*`, and the documented bare-metal
# workflow is `set -a; . ./.env; set +a` — unquoted, the shell assigns only the first
# field and then tries to EXECUTE the rest (`3 * * *`), glob-expanding the stars. You
# get a one-field schedule that cannot parse, and the timer sits disabled. Docker
# compose's env_file strips the quotes, so the quoted form is correct for both.
# WIKIKB_SCRAPE_CRON="0 3 * * *"

# The BOOT default for the timer (on unless explicitly off). Flip it at runtime
# with POST /scrape/cron {"enabled":false} — that override is deliberately NOT
# written back here, so `.env` always answers "what will this container do when it
# restarts?". GET /scrape/cron reports the live flag and this default side by side.
# WIKIKB_SCRAPE_CRON_ENABLED=1

# Which index-lookup backend to use:
#   auto     (default) try the CDX HTTP API, fall back to the index files.
#   api      index.commoncrawl.org only — one request, richest filtering, but it
#            is a free heavily-loaded service that answers 503/504 for long
#            stretches (it did so continuously while this was being written).
#   cluster  data.commoncrawl.org only — binary-search cluster.idx with HTTP range
#            requests, then range-fetch the one compressed CDX block. ~15 small
#            ranged reads instead of one request, but that bucket stays up.
# Pin to `cluster` where the API is chronically down, to skip a wasted request/URL.
# WIKIKB_CC_LOOKUP=auto

# Pin a specific crawl instead of walking the history — the reproducibility escape
# hatch (a run against a pinned crawl yields the same captures on any day).
# WIKIKB_CC_INDEX=CC-MAIN-2026-30

# THE HARVEST LEDGER. A watchlist source is harvested against EVERY crawl it has not
# been processed against yet, newest first — not just the newest index. Common Crawl
# samples the web rather than exhaustively recrawling it, so a site's captured pages
# churn heavily: measured on support.checkpoint.com, 4 crawls produced 81 documents
# where the newest crawl alone produced 21.
#
# `vault/.scrape-state.json` records every (source, crawl) pair processed — INCLUDING
# crawls that held nothing, because a published crawl is immutable and will never
# hold anything later. So the first runs walk the history (126 crawls today, back to
# 2008) and every later run touches only what has been published since, about one
# crawl a month. It is VAULT-RESIDENT so it travels with a vault copy: the far end
# resumes instead of re-downloading a decade of crawls.
#
# Override the location only if you must; unset it follows WIKIKB_VAULT_ROOT.
# WIKIKB_SCRAPE_STATE=/data/vault/.scrape-state.json

# How many not-yet-harvested crawls ONE QUEUED run may walk. The whole history is
# hours of work, which would exceed WIKIKB_JOB_TIMEOUT and get the step killed — and
# a killed step fails the chain, so nothing would be folded into the vault even
# though the harvest had made progress. Bounding it means every run finishes, folds
# in what it got, and the ledger makes the next run continue. The CLI is unbounded by
# default (`--max-indexes N` to bound it there too).
# WIKIKB_SCRAPE_MAX_INDEXES_PER_RUN=12

# Identify yourself. Common Crawl asks for a contact address, and it is the
# difference between being rate-limited and being blocked.
# WIKIKB_SCRAPE_UA=wikikb-scrape/1.0 (+mailto:you@example.com)

# Ceilings. PREFIX_LIMIT caps how many pages ONE `match: prefix` source may pull
# per run — a prefix over a big docs site can match thousands of captures, and a
# cron that occasionally writes ten thousand notes is a runaway. MIN_CHARS is the
# floor below which an extraction is reported as `too-thin` and NOT written: a
# 40-character note in the immutable tier would be cited as ground truth.
# WIKIKB_SCRAPE_PREFIX_LIMIT=25
# WIKIKB_SCRAPE_MIN_CHARS=200
# WIKIKB_SCRAPE_MAX_CHARS=400000

# HTML→Markdown uses `trafilatura` when it is installed and a bounded stdlib
# reader otherwise (GET /scrape/sources reports which is live). Nothing to
# configure — it is an optional accelerator, exactly like the dense retrieval
# layer, and the air-gapped copy-and-run model is preserved either way.


# ── 6. OPTIONAL LLM TIER (OFF BY DEFAULT) ────────────────────────────────────
# Absent these, `ask` returns EXTRACTIVE answers (quoted source spans). Setting
# them enables synthesized prose through the local gateway. The gate, citations
# and banners apply either way.
#   WIKI_LLM=local
#   WIKI_LLM_MODEL=ollama/qwen2.5:3b
# From inside a container, host.docker.internal reaches an Ollama on the host.
#   WIKI_LLM_API_BASE=http://host.docker.internal:11434
# Known trap (CLAUDE.md): a stale api_base makes the gateway silently return None
# and every answer quietly falls back to extractive. If prose vanishes, check this first.
